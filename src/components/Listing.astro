---
import type { City } from "../../shared/cities.ts";
import Page from "../layouts/Page.astro";
import { DaySection } from "../components/DaySection.tsx";
import { formatDayShort } from "../format.ts";
import { loadCrawl, loadExternal } from "../load.ts";
import { programme } from "../programme.ts";

interface Props {
  city: City;
  /** Leaves out films of this year and last year. */
  oldOnly: boolean;
}

const { city, oldOnly } = Astro.props;
const copy = oldOnly
  ? {
      tagline: `vieux films ${city.at} jour par jour`,
      description: `Les séances de vieux films ${city.at}, jour par jour, d'aujourd'hui à mardi.`,
      empty: "Plus de vieux film ce jour.",
    }
  : {
      tagline: `séances ${city.at} jour par jour`,
      description: `Toutes les séances de cinéma ${city.at}, jour par jour, d'aujourd'hui à mardi.`,
      empty: "Plus de séance ce jour.",
    };
const days = programme(loadCrawl(city.slug), loadExternal(), { oldOnly });
const home = `/${city.slug}/`;
---

<Page tagline={copy.tagline} description={copy.description}>
  <div class="bar">
    <a class="bar-city" href="/">
      {city.name}
      <span class="i i-swap" aria-hidden="true"></span>
      <span class="sr-only">, changer de ville</span>
    </a>
    <nav class="days" aria-label="Jours">
      {days.map(({ date }) => {
        const [weekday, day] = formatDayShort(date).split(" ");
        return (
          <a href={`#jour-${date}`}>
            <span class="bar-long">{formatDayShort(date)}</span>
            <span class="bar-short">
              <span>{weekday}</span> {day}
            </span>
          </a>
        );
      })}
    </nav>
    <a
      class:list={["switch", { "is-on": oldOnly }]}
      href={oldOnly ? home : `${home}vieux-films/`}
      role="switch"
      aria-checked={oldOnly ? "true" : "false"}
    >
      <span class="switch-track" aria-hidden="true">
        <span class="switch-knob"></span>
      </span>
      <span class="bar-long" aria-hidden="true">
        Vieux films seulement
      </span>
      <span class="bar-short" aria-hidden="true">
        Vieux
      </span>
      <span class="sr-only">Vieux films seulement</span>
    </a>
  </div>
  <main>
    {days.length === 0 ? (
      <p class="empty">Aucune séance à venir.</p>
    ) : (
      days.map((day) => <DaySection day={day} empty={copy.empty} />)
    )}
  </main>
</Page>
