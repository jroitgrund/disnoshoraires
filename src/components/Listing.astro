---
import type { City } from "../../shared/cities.ts";
import Page from "../layouts/Page.astro";
import { DaySection } from "../components/DaySection.tsx";
import { formatDayLong, formatDayShort } from "../format.ts";
import type { Day } from "../programme.ts";
import { dayHref } from "../routes.ts";

interface Props {
  city: City;
  /** Leaves out films of this year and last year. */
  oldOnly: boolean;
  /** Every day of the programme, for the day bar. */
  dates: readonly string[];
  /** None when the programme has no day left. */
  day: Day | undefined;
}

const { city, oldOnly, dates, day } = Astro.props;
const when = day == null ? "" : ` le ${formatDayLong(day.date)}`;
const copy = oldOnly
  ? {
      tagline: `fossiles ${city.at}${when}`,
      description: `Les séances de fossiles ${city.at}${when}, les films d'avant l'an dernier.`,
    }
  : {
      tagline: `séances ${city.at}${when}`,
      description: `Toutes les séances de cinéma ${city.at}${when}.`,
    };
---

<Page tagline={copy.tagline} description={copy.description}>
  <div class="bar">
    <a class="bar-city" href="/">
      {city.name}
      <span class="i i-swap" aria-hidden="true"></span>
      <span class="sr-only">, changer de ville</span>
    </a>
    <nav class="days" aria-label="Jours">
      {dates.map((date) => {
        const [weekday, number] = formatDayShort(date).split(" ");
        return (
          <a
            href={dayHref(city, oldOnly, dates, date)}
            aria-current={date === day?.date ? "page" : undefined}
          >
            <span class="bar-long">{formatDayShort(date)}</span>
            <span class="bar-short">
              <span>{weekday}</span> {number}
            </span>
          </a>
        );
      })}
    </nav>
    <a
      class:list={["switch", { "is-on": oldOnly }]}
      href={dayHref(city, !oldOnly, dates, day?.date)}
      role="switch"
      aria-checked={oldOnly ? "true" : "false"}
    >
      <span class="switch-track" aria-hidden="true">
        <span class="switch-knob"></span>
      </span>
      <span class="bar-long" aria-hidden="true">
        Fossiles seulement
      </span>
      <span class="bar-short" aria-hidden="true">
        Fossiles
      </span>
      <span class="sr-only">Fossiles seulement</span>
    </a>
  </div>
  <main>
    {day == null ? (
      <p class="empty">Aucune séance à venir.</p>
    ) : (
      <DaySection day={day} />
    )}
  </main>
</Page>
