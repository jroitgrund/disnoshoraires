---
import type { City } from "../../shared/cities.ts";
import Page from "../layouts/Page.astro";
import { DaySection } from "../components/DaySection.tsx";
import { formatDayLong, formatDayShort } from "../format.ts";
import type { Day } from "../programme.ts";
import { dayHref } from "../paths.ts";

interface Props {
  city: City;
  /** Leaves out films of this year and last year. */
  oldOnly: boolean;
  /** Every day of the programme, for the day bar. */
  dates: readonly string[];
  /** None when the programme has no day left. */
  day: Day | undefined;
}

const { city, oldOnly, dates, day } = Astro.props;
const when = day == null ? "" : ` le ${formatDayLong(day.date)}`;
const copy = oldOnly
  ? {
      tagline: `fossiles ${city.at}${when}`,
      description: `Les séances de fossiles ${city.at}${when}, les films d'avant l'an dernier.`,
    }
  : {
      tagline: `séances ${city.at}${when}`,
      description: `Toutes les séances de cinéma ${city.at}${when}.`,
    };
---

<Page tagline={copy.tagline} description={copy.description}>
  <div class="bar">
    <a class="bar-city" href="/">
      {city.name}
      <span class="i i-swap" aria-hidden="true"></span>
      <span class="sr-only">, changer de ville</span>
    </a>
    <nav class="days" aria-label="Jours">
      {dates.map((date) => {
        const { weekday, day: number } = formatDayShort(date);
        return (
          <a
            href={dayHref(city, oldOnly, dates, date)}
            aria-current={date === day?.date ? "page" : undefined}
          >
            <span class="bar-long">
              {weekday} {number}
            </span>
            <span class="bar-short">
              <span>{weekday}</span> {number}
            </span>
          </a>
        );
      })}
    </nav>
    <a
      class:list={["switch", { "is-on": oldOnly }]}
      href={dayHref(city, !oldOnly, dates, day?.date)}
      role="switch"
      aria-checked={oldOnly ? "true" : "false"}
    >
      <span class="switch-track" aria-hidden="true">
        <span class="switch-knob"></span>
      </span>
      <span class="bar-long" aria-hidden="true">
        Fossiles seulement
      </span>
      <span class="bar-short" aria-hidden="true">
        Fossiles
      </span>
      <span class="sr-only">Fossiles seulement</span>
    </a>
  </div>
  <main>
    {day == null ? (
      <p class="empty">Aucune séance à venir.</p>
    ) : (
      <DaySection day={day} />
    )}
  </main>
</Page>

<script>
  import { CARD_PARTS } from "../card.ts";

  const filled = new WeakSet<HTMLElement>();

  /** Puts the film's still, summary and foot in its card, from the film's
   * page. The card keeps only its title if the request fails. */
  function fill(card: HTMLElement) {
    const href = card.dataset["fiche"];
    if (href == null || filled.has(card)) {
      return;
    }
    filled.add(card);
    fetch(href)
      .then((response) => {
        if (!response.ok) {
          throw new Error(`${href}: ${String(response.status)}`);
        }
        return response.text();
      })
      .then((html) => {
        const page = new DOMParser().parseFromString(html, "text/html");
        Object.values(CARD_PARTS).forEach((part) => {
          const loaded = page.querySelector(`.${part}`);
          if (loaded != null) {
            card.querySelector(`.${part}`)?.replaceWith(loaded);
          }
        });
      })
      .catch(() => {
        filled.delete(card);
      });
  }

  function cardOf(target: EventTarget | null) {
    const id =
      target instanceof Element
        ? target.closest<HTMLElement>(".film-open")?.dataset["card"]
        : undefined;
    return id == null ? null : document.getElementById(id);
  }

  // A tap starts the request before the card opens.
  document.addEventListener("pointerdown", (event) => {
    const card = cardOf(event.target);
    if (card != null) {
      fill(card);
    }
  });

  // A modified click opens the fiche in a new tab, as a link does.
  document.addEventListener("click", (event) => {
    if (
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey
    ) {
      return;
    }
    const card = cardOf(event.target);
    if (card != null) {
      event.preventDefault();
      card.showPopover();
    }
  });

  // The event does not bubble: only a capture on the document sees every card.
  document.addEventListener(
    "beforetoggle",
    (event) => {
      if (
        !(event instanceof ToggleEvent) ||
        !(event.target instanceof HTMLElement)
      ) {
        return;
      }
      const card = event.target;
      const link = document.querySelector<HTMLElement>(
        `.film-open[data-card="${card.id}"]`,
      );
      link?.setAttribute("aria-expanded", String(event.newState === "open"));
      if (event.newState === "open") {
        fill(card);
      } else if (card.contains(document.activeElement)) {
        link?.focus();
      }
    },
    { capture: true },
  );
</script>
