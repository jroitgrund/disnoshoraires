exports[`query by AlloCiné ID 1`] = `
"SELECT ?item (GROUP_CONCAT(DISTINCT ?allocine; separator="\\u001F") AS ?allocineIds) (GROUP_CONCAT(DISTINCT ?label; separator="\\u001F") AS ?labels)
    (GROUP_CONCAT(DISTINCT ?original; separator="\\u001F") AS ?originalTitles) (GROUP_CONCAT(DISTINCT ?director; separator="\\u001F") AS ?directors)
    (MIN(YEAR(?date)) AS ?year) (GROUP_CONCAT(DISTINCT ?tmdbId; separator="\\u001F") AS ?tmdb) (GROUP_CONCAT(DISTINCT ?rtId; separator="\\u001F") AS ?rt) (GROUP_CONCAT(DISTINCT ?scId; separator="\\u001F") AS ?sc)
    (SAMPLE(?en) AS ?enwiki) (SAMPLE(?fr) AS ?frwiki)
  WHERE {
    VALUES ?wanted { "188280" "6429" }
    ?item wdt:P1265 ?wanted.
    OPTIONAL { ?item wdt:P1265 ?allocine }
    OPTIONAL { ?item rdfs:label ?label. FILTER(LANG(?label) IN ("fr", "en", "mul")) }
    OPTIONAL { ?item wdt:P1476 ?original }
    OPTIONAL { ?item wdt:P57/rdfs:label ?director. FILTER(LANG(?director) IN ("fr", "en", "mul")) }
    OPTIONAL { ?item wdt:P577 ?date }
    OPTIONAL { ?item wdt:P4947 ?tmdbId }
    OPTIONAL { ?item wdt:P1258 ?rtId }
    OPTIONAL { ?item wdt:P10100 ?scId }
    OPTIONAL { ?en schema:about ?item; schema:isPartOf <https://en.wikipedia.org/> }
    OPTIONAL { ?fr schema:about ?item; schema:isPartOf <https://fr.wikipedia.org/> }
  }
  GROUP BY ?item"
`;

exports[`query by item 1`] = `
"SELECT ?item (GROUP_CONCAT(DISTINCT ?allocine; separator="\\u001F") AS ?allocineIds) (GROUP_CONCAT(DISTINCT ?label; separator="\\u001F") AS ?labels)
    (GROUP_CONCAT(DISTINCT ?original; separator="\\u001F") AS ?originalTitles) (GROUP_CONCAT(DISTINCT ?director; separator="\\u001F") AS ?directors)
    (MIN(YEAR(?date)) AS ?year) (GROUP_CONCAT(DISTINCT ?tmdbId; separator="\\u001F") AS ?tmdb) (GROUP_CONCAT(DISTINCT ?rtId; separator="\\u001F") AS ?rt) (GROUP_CONCAT(DISTINCT ?scId; separator="\\u001F") AS ?sc)
    (SAMPLE(?en) AS ?enwiki) (SAMPLE(?fr) AS ?frwiki)
  WHERE {
    VALUES ?item { wd:Q137652478 wd:Q1304876 }
    OPTIONAL { ?item wdt:P1265 ?allocine }
    OPTIONAL { ?item rdfs:label ?label. FILTER(LANG(?label) IN ("fr", "en", "mul")) }
    OPTIONAL { ?item wdt:P1476 ?original }
    OPTIONAL { ?item wdt:P57/rdfs:label ?director. FILTER(LANG(?director) IN ("fr", "en", "mul")) }
    OPTIONAL { ?item wdt:P577 ?date }
    OPTIONAL { ?item wdt:P4947 ?tmdbId }
    OPTIONAL { ?item wdt:P1258 ?rtId }
    OPTIONAL { ?item wdt:P10100 ?scId }
    OPTIONAL { ?en schema:about ?item; schema:isPartOf <https://en.wikipedia.org/> }
    OPTIONAL { ?fr schema:about ?item; schema:isPartOf <https://fr.wikipedia.org/> }
  }
  GROUP BY ?item"
`;
